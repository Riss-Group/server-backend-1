<odoo>

    <record model="ir.ui.view" id="base_security_update_request_request_line_form_view">
        <field name="model">base.security.update.request.line</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>
                <sheet>
                    <h2>
                         <field name="name" nolabel="1" />
                    </h2>
                    <group name="top">
                        <group name="left">
                            <field name="action" />
                        </group>
                    </group>
                    <group name="main">
                        <field name="is_group_1_ids_visible" invisible="1" />
                        <field
                            name="group_1_ids"
                            options="{'no_create': True}"
                            widget="many2many_tags"
                            invisible="not is_group_1_ids_visible" required="is_group_1_ids_visible"
                        />
                        <field name="is_user_ids_visible" invisible="1" />
                        <field
                            name="user_ids"
                            options="{'no_create': True}"
                            widget="many2many_tags"
                            invisible="not is_user_ids_visible" required="is_user_ids_visible"
                        />
                        <field name="is_group_2_ids_visible" invisible="1" />
                        <field
                            name="group_2_ids"
                            options="{'no_create': True}"
                            widget="many2many_tags"
                            invisible="not is_group_2_ids_visible" required="is_group_2_ids_visible"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        model="ir.ui.view"
        id="base_security_update_request_request_line_search_view"
    >
        <field name="model">base.security.update.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="id" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="base_security_update_request_request_line_tree_view">
        <field name="model">base.security.update.request.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

</odoo>
